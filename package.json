{
  "name": "hall-queue",
  "version": "1.0.0",
  "description": "政务大厅线上预约取号与排队叫号后端服务",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "seed": "node src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
